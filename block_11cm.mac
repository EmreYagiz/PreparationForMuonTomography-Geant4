# Face-to-face scintillator gap: 11 cm.
# Centered 5 cm block. Equal scintillator-face clearances: 3 cm.
# Independent random seeds for each condition and distance.
/control/verbose 1
/run/numberOfThreads 8
/random/setSeeds 14928011 14928012
/setup/blockEnabled true
/setup/blockWidth 5 cm
/setup/blockHeight 5 cm
/setup/blockThickness 5 cm
/setup/gap 11 cm
/setup/peThreshold 1
/setup/timeWindow 15 ns
/run/initialize
/analysis/setFileName block_11cm
/run/printProgress 1000
/run/beamOn 100000
