# Face-to-face scintillator gap: 8 cm.
# Centered 5 cm block. Equal scintillator-face clearances: 1.5 cm.
# Independent random seeds for each condition and distance.
/control/verbose 1
/run/numberOfThreads 8
/random/setSeeds 14927011 14927012
/setup/blockEnabled true
/setup/blockWidth 5 cm
/setup/blockHeight 5 cm
/setup/blockThickness 5 cm
/setup/gap 8 cm
/setup/peThreshold 1
/setup/timeWindow 15 ns
/run/initialize
/analysis/setFileName block_8cm
/run/printProgress 1000
/run/beamOn 100000
