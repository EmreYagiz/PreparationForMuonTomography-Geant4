# 10 cm X x 10 cm Y common projected area. Centered 5 cm Pb block.
/control/verbose 1
/run/numberOfThreads 8
/random/setSeeds 14931111 14931112
/setup/blockEnabled true
/setup/blockWidth 5 cm
/setup/blockHeight 5 cm
/setup/blockThickness 5 cm
/setup/gap 50 cm
/setup/overlapWidth 10 cm
/setup/peThreshold 1
/setup/timeWindow 15 ns
/run/initialize
/analysis/setFileName block_50cm
/run/printProgress 1000
/run/beamOn 100000
