# Face-to-face scintillator gap: 10 cm.
# Centered 5 cm block. Equal scintillator-face clearances: 2.5 cm.
# Independent random seeds for each condition and distance.
/control/verbose 1
/run/numberOfThreads 8
/random/setSeeds 14926001 14926002
/setup/blockEnabled false
/setup/blockWidth 5 cm
/setup/blockHeight 5 cm
/setup/blockThickness 5 cm
/setup/gap 10 cm
/setup/peThreshold 1
/setup/timeWindow 15 ns
/run/initialize
/analysis/setFileName reference_10cm
/run/printProgress 1000
/run/beamOn 100000
