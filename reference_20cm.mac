# Face-to-face scintillator gap: 20 cm.
# Centered 5 cm block. Equal scintillator-face clearances: 7.5 cm.
# Independent random seeds for each condition and distance.
/control/verbose 1
/run/numberOfThreads 8
/random/setSeeds 14926201 14926202
/setup/blockEnabled false
/setup/blockWidth 5 cm
/setup/blockHeight 5 cm
/setup/blockThickness 5 cm
/setup/gap 20 cm
/setup/peThreshold 1
/setup/timeWindow 15 ns
/run/initialize
/analysis/setFileName reference_20cm
/run/printProgress 1000
/run/beamOn 100000
